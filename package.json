{
  "name": "modelshift",
  "version": "0.1.4",
  "description": "Know what breaks before your LLM is switched off: find retiring, removed and silently redirected models in your repo, and test replacements with honest statistics.",
  "license": "MIT",
  "author": "Angled Sapiens (https://github.com/angledsapiens)",
  "homepage": "https://github.com/angledsapiens/modelshift#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/angledsapiens/modelshift.git"
  },
  "bugs": {
    "url": "https://github.com/angledsapiens/modelshift/issues"
  },
  "type": "module",
  "bin": {
    "modelshift": "dist/src/bin.js"
  },
  "files": [
    "dist/src",
    "data",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm test",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "scan": "node dist/src/bin.js scan"
  },
  "keywords": [
    "llm",
    "model-deprecation",
    "migration",
    "evals",
    "openai",
    "anthropic",
    "gemini",
    "deepinfra",
    "mcp",
    "github-action",
    "cli"
  ],
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
